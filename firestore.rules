rules_version = '2';
// SEC1 — VERIFICATION CONSOLE OBLIGATOIRE AVANT TOUT PUSH / DEPLOIEMENT :
// ce fichier seul ne prouve PAS les regles reellement deployees.
// Comparer ligne a ligne, dans la console Firebase, les regles de la base
// nommee "ai-studio-android-abvfarm-2867a79a-d782-4ee4-a962-662ea47d3af4"
// ET celles de la base par defaut "(default)" avec ce fichier, et les
// aligner sur ce fichier avant tout push. Raison : une base par defaut
// restee en regles ouvertes / mode test resterait un risque si un autre
// client ou un ancien build l'utilisait encore. Correctif C9 : firebase.json
// deploie desormais ces regles vers les DEUX bases (nommee ET "(default)") ;
// la verification en console reste obligatoire avant le deploiement pour
// confirmer que la base "(default)" existe bien dans le meme projet.

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Liste des e-mails autorisés : lisible par tout utilisateur connecté
    // (contrôle d'accès à la connexion), écrite par le super admin seul.
    match /admin/access {
      allow get: if isSignedIn();
      allow list: if false;
      allow create, update: if isSuperAdmin() && isValidAccessDoc(incoming());
      allow delete: if false;
    }

    // Partages de données entre utilisateurs (lecture ou lecture+écriture).
    match /partages/{shareId} {
      allow get, list: if isSignedIn() &&
        (resource.data.ownerUid == request.auth.uid ||
         resource.data.guestEmail == request.auth.token.email ||
         isSuperAdmin());
      allow create: if isSignedIn() && isValidShare(incoming()) &&
        incoming().ownerUid == request.auth.uid &&
        shareId == incoming().ownerUid + '__' + incoming().guestEmail;
      allow update: if isSignedIn() && isValidShare(incoming()) &&
        existing().ownerUid == request.auth.uid &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().guestEmail == existing().guestEmail &&
        shareId == incoming().ownerUid + '__' + incoming().guestEmail;
      allow delete: if isSignedIn() &&
        (existing().ownerUid == request.auth.uid || isSuperAdmin());
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // ---- Accès & partages (2026-11-11, demande Mr Robot) ----
    // Super administrateur : LONTI KENFACK ARCEN (lontiarcen@gmail.com),
    // seul habilité à choisir quels e-mails peuvent utiliser l'application.
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'lontiarcen@gmail.com';
    }

    // Un utilisateur est autorisé s'il est le super administrateur OU si son
    // e-mail figure dans le document admin/access (liste tenue par le super
    // administrateur seul). Document absent = seul le super admin passe :
    // l'application le crée automatiquement à sa première connexion.
    function isAllowedUser() {
      return isSuperAdmin() ||
        (isSignedIn() &&
         exists(/databases/$(database)/documents/admin/access) &&
         request.auth.token.email in get(/databases/$(database)/documents/admin/access).data.allowedEmails);
    }

    function isValidAccessDoc(data) {
      return data.keys().hasOnly(['allowedEmails', 'updatedAt', 'updatedBy']) &&
             data.allowedEmails is list && data.allowedEmails.size() <= 500 &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64)) &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 200));
    }

    // Partages : document partages/{ownerUid}__{guestEmail} créé par le
    // propriétaire, niveau 'lecture' ou 'ecriture'.
    function isValidShare(data) {
      return data.keys().hasOnly(['ownerUid', 'ownerEmail', 'guestEmail', 'level', 'createdAt']) &&
             data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128 &&
             data.guestEmail is string && data.guestEmail.size() > 3 && data.guestEmail.size() <= 200 &&
             data.level in ['lecture', 'ecriture'] &&
             (!('ownerEmail' in data) || (data.ownerEmail is string && data.ownerEmail.size() <= 200)) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function shareLevel(ownerUid) {
      return exists(/databases/$(database)/documents/partages/$(ownerUid + '__' + request.auth.token.email))
        ? get(/databases/$(database)/documents/partages/$(ownerUid + '__' + request.auth.token.email)).data.level
        : '';
    }

    function hasShareRead(userId) {
      return isSignedIn() && shareLevel(userId) != '';
    }

    function hasShareWrite(userId) {
      return isSignedIn() && shareLevel(userId) == 'ecriture';
    }

    // Validation helper for user profile
    // m17 : plafond du nombre de champs (avant : champs supplementaires
    // illimites, un profil pouvait embarquer n'importe quel contenu).
    // m15 : createdAt, quand il est present, doit etre un timestamp passe.
    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.keys().size() <= 20 &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 200)) &&
             (!('displayName' in data) || data.displayName == null || (data.displayName is string && data.displayName.size() <= 200)) &&
             (!('farmName' in data) || data.farmName == null || (data.farmName is string && data.farmName.size() <= 200)) &&
             (!('createdAt' in data) || data.createdAt == null || (data.createdAt is timestamp && data.createdAt <= request.time)) &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp);
    }

    // Validation cheptel (SEC, compatible import) : les documents d'export
    // n'ont ni userId ni createdAt, et updatedAt est une chaine ISO, pas un
    // timestamp. On ne peut donc PAS appliquer ici isValidRabbit,
    // isValidMating, etc., ni exiger createdAt, sans casser l'import et la
    // synchronisation existants. Ce qui est verifie, sans casser l'import :
    // kind dans la liste des 10 kinds du client, docId prefixe par ce kind,
    // id present (chaine 1..128 ou entier, cas des imports anciens), type
    // d'updatedAt, et nombre de champs <= 200. Limites documentees (voir
    // rapport section 11) : pas de plafond d'octets par document (borne
    // Firestore 1 Mio), pas de validation par champ et par kind, pas de
    // controle du contenu des chaines ; la validation stricte par champ
    // reste cote client dans les formulaires.
    function isValidCheptelKind(kind) {
      return kind in ['rabbit', 'mating', 'weight', 'treatment', 'item', 'feed', 'tx', 'batch', 'reminder', 'cage'];
    }

    function isCheptelDocId(kind, docId) {
      return (kind == 'rabbit' && docId.matches('^rabbit-.+')) ||
             (kind == 'mating' && docId.matches('^mating-.+')) ||
             (kind == 'weight' && docId.matches('^weight-.+')) ||
             (kind == 'treatment' && docId.matches('^treatment-.+')) ||
             (kind == 'item' && docId.matches('^item-.+')) ||
             (kind == 'feed' && docId.matches('^feed-.+')) ||
             (kind == 'tx' && docId.matches('^tx-.+')) ||
             (kind == 'batch' && docId.matches('^batch-.+')) ||
             (kind == 'reminder' && docId.matches('^reminder-.+')) ||
             (kind == 'cage' && docId.matches('^cage-.+'));
    }

    function isValidCheptel(data, docId) {
      return ('kind' in data) && isValidCheptelKind(data.kind) &&
             isCheptelDocId(data.kind, docId) &&
             ('id' in data) &&
             ((data.id is string && data.id.size() > 0 && data.id.size() <= 128 && docId == data.kind + '-' + data.id) ||
              (data.id is int && docId.matches('^' + data.kind + '-[0-9]+$'))) &&
             /* M21 (durcissement progressif) : updatedAt desormais REQUIS
                (chaine ISO non vide, <= 64 car. — le client web l'ecrit a
                chaque save) et plafonds de taille sur les champs texte
                principaux quand ils sont des chaines. */
             ('updatedAt' in data) && data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 64 &&
             (!('name' in data) || !(data.name is string) || data.name.size() <= 300) &&
             (!('title' in data) || !(data.title is string) || data.title.size() <= 300) &&
             (!('label' in data) || !(data.label is string) || data.label.size() <= 300) &&
             (!('code' in data) || !(data.code is string) || data.code.size() <= 100) &&
             data.keys().size() <= 200;
    }

    // Validation helper for rabbits
    function isValidRabbit(data) {
      return data.keys().size() <= 50 && data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.sex is string && data.sex.size() > 0 && data.sex.size() <= 50 &&
             (!('localId' in data) || data.localId is int) &&
             (!('dateOfBirth' in data) || data.dateOfBirth is int) &&
             (!('breed' in data) || (data.breed is string && data.breed.size() <= 100)) &&
             (!('cageNumber' in data) || (data.cageNumber is string && data.cageNumber.size() <= 50)) &&
             (!('weight' in data) || data.weight is number) &&
             (!('fatherId' in data) || data.fatherId == null || data.fatherId is int) &&
             (!('motherId' in data) || data.motherId == null || data.motherId is int) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             (!('isActive' in data) || data.isActive is bool) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('imageUri' in data) || data.imageUri == null || (data.imageUri is string && data.imageUri.size() <= 1000)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Validation helper for mating records
    function isValidMating(data) {
      return data.keys().size() <= 50 && data.userId is string && data.userId == request.auth.uid &&
             data.maleId is int &&
             data.femaleId is int &&
             data.matingDate is int &&
             (!('localId' in data) || data.localId is int) &&
             (!('expectedBirthDate' in data) || data.expectedBirthDate is int) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Validation helper for inventory items
    function isValidInventory(data) {
      return data.keys().size() <= 50 && data.userId is string && data.userId == request.auth.uid &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 50 &&
             (!('localId' in data) || data.localId is int) &&
             (!('quantity' in data) || data.quantity is number) &&
             (!('unit' in data) || (data.unit is string && data.unit.size() <= 30)) &&
             (!('pricePerUnit' in data) || data.pricePerUnit is number) &&
             (!('totalPrice' in data) || data.totalPrice is number) &&
             (!('purchaseDate' in data) || data.purchaseDate is int) &&
             (!('durationMonths' in data) || data.durationMonths is int) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Validation helper for reminders
    function isValidReminder(data) {
      return data.keys().size() <= 50 && data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 150 &&
             data.dueDate is int &&
             (!('localId' in data) || data.localId is int) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('priority' in data) || (data.priority is string && data.priority.size() <= 50)) &&
             (!('isCompleted' in data) || data.isCompleted is bool) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Validation helper for treatments
    function isValidTreatment(data) {
      return data.keys().size() <= 50 && data.userId is string && data.userId == request.auth.uid &&
             data.rabbitId is int &&
             data.date is int &&
             (!('localId' in data) || data.localId is int) &&
             (!('type' in data) || (data.type is string && data.type.size() <= 50)) &&
             (!('designation' in data) || (data.designation is string && data.designation.size() <= 150)) &&
             (!('dosage' in data) || (data.dosage is string && data.dosage.size() <= 100)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             (!('nextDueDate' in data) || data.nextDueDate == null || data.nextDueDate is int) &&
             (!('withdrawalDays' in data) || data.withdrawalDays is int) &&
             (!('withdrawalEndDate' in data) || data.withdrawalEndDate == null || data.withdrawalEndDate is int) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Validation helper for weights
    function isValidWeight(data) {
      return data.keys().size() <= 50 && data.userId is string && data.userId == request.auth.uid &&
             data.rabbitId is int &&
             data.weight is number &&
             data.recordDate is int &&
             (!('localId' in data) || data.localId is int) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Validation helper for daily feed logs
    function isValidFeedLog(data) {
      return data.keys().size() <= 50 && data.userId is string && data.userId == request.auth.uid &&
             data.feedDate is int &&
             data.quantityGrams is number &&
             (!('localId' in data) || data.localId is int) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Validation helper for fattening batches
    function isValidFatteningBatch(data) {
      return data.keys().size() <= 50 && data.userId is string && data.userId == request.auth.uid &&
             data.batchCode is string && data.batchCode.size() > 0 && data.batchCode.size() <= 100 &&
             (!('localId' in data) || data.localId is int) &&
             (!('matingRecordId' in data) || data.matingRecordId == null || data.matingRecordId is int) &&
             (!('weaningDate' in data) || data.weaningDate is int) &&
             (!('initialCount' in data) || data.initialCount is int) &&
             (!('currentCount' in data) || data.currentCount is int) &&
             (!('mortalityCount' in data) || data.mortalityCount is int) &&
             (!('cageLocation' in data) || (data.cageLocation is string && data.cageLocation.size() <= 100)) &&
             (!('averageWeightGrams' in data) || data.averageWeightGrams is int) &&
             (!('targetSaleDate' in data) || data.targetSaleDate is int) &&
             (!('status' in data) || (data.status is string && data.status.size() <= 50)) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // Validation helper for financial transactions
    function isValidFinancialTransaction(data) {
      return data.keys().size() <= 50 && data.userId is string && data.userId == request.auth.uid &&
             (!('localId' in data) || data.localId is int) &&
             (!('date' in data) || data.date is int) &&
             (!('type' in data) || (data.type is string && data.type.size() <= 50)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             (!('amountFcfa' in data) || data.amountFcfa is number) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('relatedBatchId' in data) || data.relatedBatchId == null || data.relatedBatchId is int) &&
             (!('relatedRabbitId' in data) || data.relatedRabbitId == null || data.relatedRabbitId is int) &&
             (!('updatedAt' in data) || data.updatedAt == null || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    // User Profile
    match /users/{userId} {
      allow get, list: if isOwner(userId) && isAllowedUser();
      allow create: if isOwner(userId) && isAllowedUser() && isValidId(userId) && isValidUserProfile(incoming());
      // m15 : createdAt IMMUABLE a la mise a jour quand il existe deja —
      // avant, rien n'empechait de le reecrire a chaque connexion. Non requis
      // a la creation : l'app Android ne l'envoie jamais, l'exiger casserait
      // ses creations de profil.
      allow update: if isOwner(userId) && isAllowedUser() && isValidId(userId) && isValidUserProfile(incoming()) &&
                       (!('createdAt' in existing()) || existing().createdAt == null ||
                        !('createdAt' in incoming()) || incoming().createdAt == existing().createdAt);
      allow delete: if isOwner(userId) && isAllowedUser();

      // Cheptel documents subcollection used by Web App
      // SEC : validation compatible import (voir isValidCheptel). La lecture
      // et la suppression restent reservees au proprietaire, sans validation
      // de contenu : une suppression ne doit pas etre bloquee par un
      // document ancien mal forme.
      match /cheptel/{docId} {
        allow read: if (isOwner(userId) && isAllowedUser()) || hasShareRead(userId);
        allow create, update: if ((isOwner(userId) && isAllowedUser()) || hasShareWrite(userId)) && isValidCheptel(incoming(), docId);
        allow delete: if (isOwner(userId) && isAllowedUser()) || hasShareWrite(userId);
      }

      // Rabbits subcollection
      match /rabbits/{rabbitId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(rabbitId) &&
                         isValidRabbit(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidRabbit(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['localId', 'name', 'sex', 'dateOfBirth', 'breed', 'cageNumber', 'weight', 'fatherId', 'motherId', 'notes', 'isActive', 'status', 'imageUri', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      // Mating records subcollection
      match /mating_records/{matingId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(matingId) &&
                         isValidMating(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidMating(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['localId', 'maleId', 'femaleId', 'matingDate', 'expectedBirthDate', 'status', 'notes', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      // Inventory subcollection
      match /inventory_items/{itemId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(itemId) &&
                         isValidInventory(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidInventory(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['localId', 'name', 'category', 'quantity', 'unit', 'pricePerUnit', 'totalPrice', 'purchaseDate', 'durationMonths', 'notes', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      // Reminders subcollection
      match /reminders/{reminderId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(reminderId) &&
                         isValidReminder(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidReminder(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['localId', 'title', 'description', 'dueDate', 'priority', 'isCompleted', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      // Treatments subcollection
      match /treatments/{treatmentId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(treatmentId) &&
                         isValidTreatment(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidTreatment(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['localId', 'rabbitId', 'type', 'designation', 'date', 'dosage', 'notes', 'nextDueDate', 'withdrawalDays', 'withdrawalEndDate', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      // Weights subcollection
      match /weights/{weightId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(weightId) &&
                         isValidWeight(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidWeight(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['localId', 'rabbitId', 'weight', 'recordDate', 'notes', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      // Feed logs subcollection
      match /feed_logs/{feedLogId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(feedLogId) &&
                         isValidFeedLog(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidFeedLog(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['localId', 'feedDate', 'quantityGrams', 'notes', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      // Fattening batches subcollection
      match /fattening_batches/{batchId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(batchId) &&
                         isValidFatteningBatch(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidFatteningBatch(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['localId', 'batchCode', 'matingRecordId', 'weaningDate', 'initialCount', 'currentCount', 'mortalityCount', 'cageLocation', 'averageWeightGrams', 'targetSaleDate', 'status', 'updatedAt']);
        allow delete: if isOwner(userId);
      }

      // Financial transactions subcollection
      match /financial_transactions/{txId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(txId) &&
                         isValidFinancialTransaction(incoming()) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time;
        allow update: if isOwner(userId) &&
                         isValidFinancialTransaction(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['localId', 'date', 'type', 'category', 'amountFcfa', 'description', 'relatedBatchId', 'relatedRabbitId', 'updatedAt']);
        allow delete: if isOwner(userId);
      }
    }
  }
}
